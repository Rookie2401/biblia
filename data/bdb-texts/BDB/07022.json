a> = <a data-ref=\"Jeremiah 52:6\" href=\"/Jeremiah.52.6\">Je 52:6</a>, <span dir=\"rtl\">חזק עַל</span> <a data-ref=\"Genesis 47:20\" href=\"/Genesis.47.20\">Gn 47:20</a>; c. <span dir=\"rtl\">כָבֵד</span> <a data-ref=\"Genesis 12:10\" href=\"/Genesis.12.10\">12:10</a>; <a data-ref=\"Genesis 47:4\" href=\"/Genesis.47.4\">47:4</a>, <a data-ref=\"Genesis 47:13\" href=\"/Genesis.47.13\">13</a>; <span dir=\"rtl\">גָּדוֹל</span> <a data-ref=\"II Kings 6:25\" href=\"/II_Kings.6.25\">2 K 6:25</a>; <span dir=\"rtl\">זַעלעֲפוֹת ר׳</span> <a data-ref=\"Lamentations 5:10\" href=\"/Lamentations.5.10\">La 5:10</a>; <span dir=\"rtl\">מְזֵי ר׳</span> <a data-ref=\"Deuteronomy 32:24\" href=\"/Deuteronomy.32.24\">Dt 32:24</a> + <a data-ref=\"Isaiah 5:13\" href=\"/Isaiah.5.13\">Is 5:13</a> (v. [<a data-ref=\"BDB, מָזֶה\" href=\"/BDB,_מָזֶה\", dir=\"rtl\">מָזֶה</a>]), <span dir=\"rtl\">תַּחֲלוּאֵי ר׳</span> <a data-ref=\"Jeremiah 14:18\" href=\"/Jeremiah.14.18\">Je 14:18</a>, <span dir=\"rtl\">חַלֲלֵי ר׳</span> <a data-ref=\"Lamentations 5:9\" href=\"/Lamentations.5.9\">La 5:9</a>, <span dir=\"rtl\">אֲסֻפֵי ר׳</span> <a data-ref=\"Ezekiel 34:29\" href=\"/Ezekiel.34.29\">Ez 34:29</a>; <span dir=\"rtl\">חִצֵּי הָר׳</span> <a data-ref=\"Ezekiel 5:16\" href=\"/Ezekiel.5.16\">5:16</a>; as scourge of <span dir=\"rtl\">י׳</span> (+ <span dir=\"rtl\">חֶרֶב</span>, <span dir=\"rtl\">דֶּבֶ</span>, etc.; especially Je Ez), <a data-ref=\"Jeremiah 5:12\" href=\"/Jeremiah.5.12\">Je 5:12</a>; <a data-ref=\"Jeremiah 11:22\" href=\"/Jeremiah.11.22\">11:22</a>; <a data-ref=\"Jeremiah 14:12\" href=\"/Jeremiah.14.12\">14:12</a>; <a data-ref=\"Jeremiah 21:7\" href=\"/Jeremiah.21.7\">21:7</a>, <a data-ref=\"Jeremiah 21:9\" href=\"/Jeremiah.21.9\">9</a> <a data-ref=\"Ezekiel 5:2\" href=\"/Ezekiel.5.2\">Ez 5:2</a>; <a data-ref=\"Ezekiel 6:11\" href=\"/Ezekiel.6.11\">6:11</a>, <a data-ref=\"Ezekiel 6:12\" href=\"/Ezekiel.6.12\">12</a> +, etc.; fig. of lack of <span dir=\"rtl\">י׳</span>’s word <a data-ref=\"