{"headword":"אֲגַם","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>n.</strong>[<strong>m.</strong>] <strong>troubled pool (</strong>Aramaic <em>id.</em>, <span dir=\"rtl\">ܐܶܓܡܳܐ</span>, As. <em>agammu</em> Dl<sup>W</sup><strong>)</strong>—<span dir=\"rtl\">א׳</span> abs. <a data-ref=\"Isaiah 35:7\" href=\"/Isaiah.35.7\">Is 35:7</a>; cstr. <a data-ref=\"Isaiah 41:18\" href=\"/Isaiah.41.18\">41:18</a> + 2t.; <span dir=\"rtl\">אֲגַמִּים</span> <a data-ref=\"Exodus 8:1\" href=\"/Exodus.8.1\">Ex 8:1</a> + <a data-ref=\"Exodus 8:2\" href=\"/Exodus.8.2\">2</a>t.; <span dir=\"rtl\">אַגְמֵי</span> <a data-ref=\"Isaiah 14:23\" href=\"/Isaiah.14.23\">Is 14:23</a>; <span dir=\"rtl\">אַגְמֵיהֶם</span> <a data-ref=\"Exodus 7:19\" href=\"/Exodus.7.19\">Ex 7:19</a>—"},{"senses":[{"definition":"<em>troubled</em> or <em>muddy</em> (gloomy) <em>pools</em> or <em>marshes</em>, pl. <span dir=\"rtl\">א׳ מַיִם</span> <a data-ref=\"Isaiah 14:23\" href=\"/Isaiah.14.23\">Is 14:23</a>."}],"num":"1."},{"senses":[{"definition":"any <em>pool, pond</em>, sg. <span dir=\"rtl\">א׳ מַיִם</span> <a data-ref=\"Isaiah 41:18\" href=\"/Isaiah.41.18\">Is 41:18</a> <a data-ref=\"Psalms 107:35\" href=\"/Psalms.107.35\">ψ 107:35</a>; <a data-ref=\"Psalms 114:8\" href=\"/Psalms.114.8\">114:8</a>; pl. without <span dir=\"rtl\">מַיִם</span> <a data-ref=\"Exodus 7:19\" href=\"/Exodus.7.19\">Ex 7:19</a>; <a data-ref=\"Exodus 8:1\" href=\"/Exodus.8.1\">8:1</a> (P) <a data-ref=\"Isaiah 42:15\" href=\"/Isaiah.42.15\">Is 42:15</a>."}],"num":"2."},{"senses":[{"definition":"<em>swamp-reed, rush</em> (= <span dir=\"rtl\">אַגְמוֹן</span>) <a data-ref=\"Jeremiah 51:32\" href=\"/Jeremiah.51.32\">Je 51:32</a>."}],"num":"3."}]},"rid":"BDB00108","strong_numbers":["98"],"next_hw":"אָגֵם","prev_hw":"אגם","all_cited":true,"quotes":[],"GK":["106","107"],"TWOT":["18a"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB D