{"headword":"זֶ֫רַח²","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>n.pr.m. (</strong>on form cf. Lg<sup>BN77, and Anm.</sup><strong>)</strong>—"},{"senses":[{"definition":"𝔊 Ζαρα, son of Judah and Tamar <a data-ref=\"Genesis 38:30\" href=\"/Genesis.38.30\">Gn 38:30</a>; <a data-ref=\"Genesis 46:12\" href=\"/Genesis.46.12\">46:12</a> (both J), <a data-ref=\"I Chronicles 2:4\" href=\"/I_Chronicles.2.4\">1 Ch 2:4</a> (all <span dir=\"rtl\">זָ֑רַח</span>), v <a data-ref=\"I Chronicles 2:6\" href=\"/I_Chronicles.2.6\">6</a>; as head of a family <a data-ref=\"Numbers 26:20\" href=\"/Numbers.26.20\">Nu 26:20</a> <a data-ref=\"Joshua 7:1\" href=\"/Joshua.7.1\">Jos 7:1</a> (both P), v <a data-ref=\"Joshua 7:18\" href=\"/Joshua.7.18\">18</a>, <a data-ref=\"Joshua 7:24\" href=\"/Joshua.7.24\">24</a> (JE), <a data-ref=\"Joshua 22:20\" href=\"/Joshua.22.20\">22:20</a> (P) <a data-ref=\"I Chronicles 9:6\" href=\"/I_Chronicles.9.6\">1 Ch 9:6</a> (𝔊L Ζηρα), <a data-ref=\"Nehemiah 11:24\" href=\"/Nehemiah.11.24\">Ne 11:24</a> (cf. Sm<sup>Listen 7</sup>)."}],"num":"1."},{"senses":[{"definition":"Edomites:"},{"senses":[{"definition":"𝔊 Ζαρε <a data-ref=\"Genesis 36:13\" href=\"/Genesis.36.13\">Gn 36:13</a>, <a data-ref=\"Genesis 36:17\" href=\"/Genesis.36.17\">17</a> (both P) = <a data-ref=\"I Chronicles 1:37\" href=\"/I_Chronicles.1.37\">1 Ch 1:37</a>."}],"num":"a."},{"senses":[{"definition":"𝔊 Ζαρα <a data-ref=\"Genesis 36:33\" href=\"/Genesis.36.33\">Gn 36:33</a> (P) = <a data-ref=\"I Chronicles 1:44\" href=\"/I_Chronicles.1.44\">1 Ch 1:44</a> (<strong>b</strong>=<strong>a</strong>?)."}],"num":"b."}],"num":"2."},{"senses":[{"definition":"𝔊L Ζαρα, Levites:"},{"senses":[{"definition":"(var. Ιααρα) <a data-ref=\"I Chronicles 6:6\" href=\"/I_Chronicles.6.6\">1 Ch 6:6</a>."}],"num":"a."},{"senses":[{"definition":"(var. Ζααραι) <a data-ref=\"I Chronicles 6:26\" href=\"/I_Chronicles.6.26\">1 Ch 6:26</a>."}],"num":"b."}],"num":"3."},{"senses":[{"definition":"head of a Simeonite family, 𝔊 Ζαρα <a data-ref=\"Numbers 26:13\" href=\"/Numbers.26.13\">Nu 26:13</a> (P), <a data-ref=\"I Chronicles 4:24\" href=\"/I_Chronicles.4.24\">1 Ch 4:24</a> (var. Ζαρες) (= <span dir=\"rtl\">צֹחַר</span> 𝔊 Σααρ <a data-ref=\"Genesis 46:10\" href=\"/Genesis.46.10\">Gn 46:10</a> <a data-ref=\"Exodus 6:15\" href=\"/Exodus.6.15\">Ex 6:15</a>, cf. Di <a data-ref=\"Numbers 26:13\" href=\"/Numbers.26.13\">Nu 26:13</a>)."}],"num":"4."},{"senses":[{"definition":"a Cushite, 𝔊 Ζαρε, foe of king Asa <a data-ref=\"II Chronicles 14:8\" href=\"/II_Chronicles.14.8\">2 Ch 14:8</a>."}],"num":"5."}]},"rid":"BDB02739","strong_numbers":["2225","2226"],"next_hw":"זַרְחִי","prev_hw":"זֶ֫רַח","all_cited":true,"ordinal":"II.","quotes":[],"GK":["2437","2438"],"TWOT":["580a"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}