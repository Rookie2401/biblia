Amos.5.22\">Am 5:22</a>."}],"num":"2."},{"senses":[{"definition":"<em>be pleased:</em>"},{"senses":[{"definition":"<em>determined</em>, c. inf. <a data-ref=\"Psalms 40:14\" href=\"/Psalms.40.14\">ψ 40:14</a>."}],"num":"a."},{"senses":[{"definition":"c. <span dir=\"rtl\">בּ</span> pers. <a data-ref=\"I Chronicles 28:4\" href=\"/I_Chronicles.28.4\">1 Ch 28:4</a>."}],"num":"b."}],"num":"3."},{"senses":[{"definition":"<em>make acceptable, satisfy</em> (by paying off debt), subj. land, paying off its sabbaths (Di Dr al. <em>accept</em>, be satisfied with [in payment]) <a data-ref=\"Leviticus 26:34\" href=\"/Leviticus.26.34\">Lv 26:34</a>, <a data-ref=\"Leviticus 26:43\" href=\"/Leviticus.26.43\">43</a>; <a data-ref=\"II Chronicles 36:21\" href=\"/II_Chronicles.36.21\">2 Ch 36:21</a>, c. acc. of guilt incurred <span dir=\"rtl\">(עָוֹן)</span> <a data-ref=\"Leviticus 26:41\" href=\"/Leviticus.26.41\">Lv 26:41</a>, <a data-ref=\"Leviticus 26:43\" href=\"/Leviticus.26.43\">43</a> (< point all these as <strong>Hiph.</strong>, so SS Gerber)."}],"num":"4."}],"form":"Qal"},{"senses":[{"definition":"Pf. 3 ms. <span dir=\"rtl\">נִרְצָה</span> <a data-ref=\"Leviticus 1:4\" href=\"/Leviticus.1.4\">Lv 1:4</a> <a data-ref=\"Isaiah 40:2\" href=\"/Isaiah.40.2\">Is 40:2</a>; Impf. 3 ms. <span dir=\"rtl\">יֵרָצֶה</span> <a data-ref=\"Leviticus 7:18\" href=\"/Leviticus.7.18\">Lv 7:18</a> +, etc.;—"},{"senses":[{"definition":"pass. of <strong>Qal 2</strong>, <em>be accepted</em>, of sacrifices, c. ל pers., <a data-ref=\"Leviticus 1:4\" href=\"/Leviticus.1.4\">Lv 1:4</a>; <a data-ref=\"Leviticus 22:25\" href=\"/Leviticus.22.25\">22:25</a>; c. ל of sacrifice <a data-ref=\"Leviticus 22:23\" href=\"/Leviticus.22.23\">22:23</a>, <a data-ref=\"Leviticus 22:27\" href=\"/Leviticus.22.27\">27</a>; abs. <a data-ref=\"Leviticus 7:18\" href=\"/Leviticus.7.18\">7:18</a>; <a data-ref=\"Leviticus 19:7\" href=\"/Leviticus.19.7\">19:7</a>."}],"num":"1."},{"senses":[{"definition":"pass. of <strong>Qal 4</strong>: <span dir=\"rtl\">נִרְצָה עֲוֹנָהּ</span> <a data-ref=\"Isaiah 40:2\" href=\"/Isaiah.40.2\">Is 40:2</a> <em>her punishment is accepted</em> (as satisfactory)."}],"num":"2."}],"form":"Niph."},{"senses":[{"definition":"Impf. 3 mpl. <span dir=\"rtl\">יְרַצּוּ</span> <a data-ref=\"Job 20:10\" href=\"/Job.20.10\">Jb 20:10</a>, c. acc. <span dir=\"rtl\">דַּלִּים</span> <em>seek the favour of the poor</em> (but Bu SS Gerber from <span dir=\"rtl\">רצץ</span>)."}],"form":"Pi."},{"senses":[{"definition":"Pf. 3 fs. <span dir=\"rtl\">וְהִרְצָת</span> (Ges<sup>§ 75 m</sup>) consec. <a data-ref=\"Leviticus 26:34\" href=\"/Leviticus.26.34\">Lv 26:34</a> <em>the land shall pay off her sabbaths</em> (acc.), cf. <strong>Qal 4</strong>."}],"form":"Hiph."},{"senses":[{"definition":"Impf. 3 ms. <span dir=\"rtl\">יִתְרַצֶּה</span> <a data-ref=\"I Samuel 29:4\" href=\"/I_Samuel.29.4\">1 S 29:4</a> with what <em>shall he make himself acceptable unto</em> <span dir=\"rtl\">(אֶל)</span> his lord? + 3 mpl. <span dir=\"rtl\">יִתְרַצּוּ</span> <a data-ref=\"Hosea 4:10\" href=\"/Hosea.4.10\">Ho 4:10</a> 𝔊 We Now (for MT <span dir=\"rtl\">יפרצו</span>) <em>they shall</em> not <em>have delight</em>."}],"form":"Hithp."}]},"rid":"BDB09510","strong_numbers":["7521"],"next_hw":"רָצוֹן","prev_hw":"רָצַד","all_cited":true,"root":true,"quotes":[],"GK":["8352","8354","8355"],"TWOT":["2207"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}