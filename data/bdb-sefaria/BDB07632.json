{"headword":"תַּ֫עַר","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>n.m.</strong> <sup>ψ 52:4</sup> and (<a data-ref=\"Isaiah 7:20\" href=\"/Isaiah.7.20\">Is 7:20</a>) <strong>f. razor, sheath</strong>;—"},{"senses":[{"senses":[{"definition":"<em>razor</em>, abs. <span dir=\"rtl\">יְגַלַּח בְּת׳</span> <a data-ref=\"Isaiah 7:20\" href=\"/Isaiah.7.20\">Is 7:20</a> (fig.); subj. of <span dir=\"rtl\">לֹא יַעֲבֹר עַל־רֹאשׁ</span> <a data-ref=\"Numbers 6:5\" href=\"/Numbers.6.5\">Nu 6:5</a>, obj. of <span dir=\"rtl\">הֶעֱבִיר עַל־</span> <a data-ref=\"Numbers 8:7\" href=\"/Numbers.8.7\">8:7</a> (P), cf. cstr. <span dir=\"rtl\">ת׳ הַגַּלָּבִים</span> <a data-ref=\"Ezekiel 5:1\" href=\"/Ezekiel.5.1\">Ez 5:1</a>; abs. <span dir=\"rtl\">כְּת׳ מְלֻטָּשׁ</span> <a data-ref=\"Psalms 52:4\" href=\"/Psalms.52.4\">ψ 52:4</a> (sim. of tongue)."}],"num":"a."},{"senses":[{"definition":"cstr. <span dir=\"rtl\">ת׳ הַסֹּפֵר</span> <a data-ref=\"Jeremiah 36:23\" href=\"/Jeremiah.36.23\">Je 36:23</a> = <em>penknife</em>."}],"num":"b."}],"num":"1."},{"senses":[{"definition":"<em>sheath</em>, always sf. of sword: <span dir=\"rtl\">בְּתַעְרָהּ</span> <a data-ref=\"II Samuel 20:8\" href=\"/II_Samuel.20.8\">2 S 20:8</a>; of drawing sword, <span dir=\"rtl\">שָׁלַף מִתּ׳</span> <a data-ref=\"I Samuel 17:51\" href=\"/I_Samuel.17.51\">1 S 17:51</a>, <span dir=\"rtl\">הוֹצַיא מִתּ׳</span> <a data-ref=\"Ezekiel 21:8\" href=\"/Ezekiel.21.8\">Ez 21:8</a>, <a data-ref=\"Ezekiel 21:10\" href=\"/Ezekiel.21.10\">10</a>, <span dir=\"rtl\">תֵּצֵא מִתּ׳</span> v <a data-ref=\"Ezekiel 21:9\" href=\"/Ezekiel.21.9\">9</a>; of sheathing, <span dir=\"rtl\">הֵאָֽסְפִי אֶל־תַּעְרֵךְ</span> <a data-ref=\"Jeremiah 47:6\" href=\"/Jeremiah.47.6\">Je 47:6</a>; <span dir=\"rtl\">הָשַׁב אֶל־תַּעְרָהּ</span> <a data-ref=\"Ezekiel 21:35\" href=\"/Ezekiel.21.35\">Ez 21:35</a>."}],"num":"2."}]},"rid":"BDB07632","strong_numbers":["8593"],"next_hw":"עָרוֹד","prev_hw":"מַעֲרָת²","all_cited":true,"