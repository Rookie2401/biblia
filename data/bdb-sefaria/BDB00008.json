ent, (subj. <span dir=\"rtl\">י׳</span>) obj. pers. <a data-ref=\"Leviticus 23:30\" href=\"/Leviticus.23.30\">Lv 23:30</a> (sq. <span dir=\"rtl\">מִקֶּרֶב עַמָּהּ</span>; ‖ <span dir=\"rtl\">כָּרַת</span> v <a data-ref=\"Leviticus 23:29\" href=\"/Leviticus.23.29\">29</a>); <a data-ref=\"Jeremiah 49:38\" href=\"/Jeremiah.49.38\">Je 49:38</a> (sq. <span dir=\"rtl\">מִשָּׁם</span>); <a data-ref=\"Obadiah 1:8\" href=\"/Obadiah.1.8\">Ob 8</a> (sq. <span dir=\"rtl\">מֵאֱדוֹם</span>); obj. nation, Ammon <a data-ref=\"Ezekiel 25:7\" href=\"/Ezekiel.25.7\">Ez 25:7</a> (sq. <span dir=\"rtl\">מן־הארצות</span>; ‖ <span dir=\"rtl\">כָּרַת</span>), cf. v <a data-ref=\"Ezekiel 25:16\" href=\"/Ezekiel.25.16\">16</a>; Canaanites <a data-ref=\"Deuteronomy 8:20\" href=\"/Deuteronomy.8.20\">Dt 8:20</a> (sq. <span dir=\"rtl\">מִפְּנֵיכֶם</span>); Canaan = Philistines <a data-ref=\"Zephaniah 2:5\" href=\"/Zephaniah.2.5\">Zp 2:5</a> (‖ <span dir=\"rtl\">כָּרַת</span>); especially Isr. <a data-ref=\"Deuteronomy 28:51\" href=\"/Deuteronomy.28.51\">Dt 28:51</a>, <a data-ref=\"Deuteronomy 28:63\" href=\"/Deuteronomy.28.63\">63</a> (‖ <span dir=\"rtl\">הִשְׁמִיד</span>), cf. <a data-ref=\"Joshua 7:7\" href=\"/Joshua.7.7\">Js 7:7</a>; also abs. <a data-ref=\"Jeremiah 18:7\" href=\"/Jeremiah.18.7\">Je 18:7</a> (‖ <span dir=\"rtl\">לִנְתוֹשׁ וְלִנְתוֹץ</span>); = <a data-ref=\"Jeremiah 1:10\" href=\"/Jeremiah.1.10\">1:10</a> (+ <span dir=\"rtl\">וְלַהֲרוֹס</span>) = <a data-ref=\"Jeremiah 31:28\" href=\"/Jeremiah.31.28\">31:28</a> (+ <span dir=\"rtl\">וּלְהָרֵעַ</span>); animals <a data-ref=\"Ezekiel 32:13\" href=\"/Ezekiel.32.13\">Ez 32:13</a> (sq. <span dir=\"rtl\">מֵעַל מַיִם רַבִּים</span>); cf. <a data-ref=\"Deuteronomy 7:10\" href=\"/Deuteronomy.7.10\">Dt 7:10</a>; <a data-ref=\"Psalms 143:12\" href=\"/Psalms.143.12\">ψ 143:12</a> (‖ <span dir=\"rtl\">הִצְמִית</span>); (human subj.), obj. servants of Baal <a data-ref=\"II Kings 10:19\" href=\"/II_Kings.10.19\">2 K 10:19</a>, obj. nation <a 