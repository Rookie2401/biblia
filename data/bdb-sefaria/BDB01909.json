Moab <a data-ref=\"Isaiah 16:8\" href=\"/Isaiah.16.8\">Is 16:8</a>, <a data-ref=\"Isaiah 16:9\" href=\"/Isaiah.16.9\">9</a> <a data-ref=\"Jeremiah 48:32\" href=\"/Jeremiah.48.32\">Je 48:32</a>.—On the vine in Syria cf. Anderlind<sup>ZPV 1888, 160 ff.</sup>"}]},"rid":"BDB01909","strong_numbers":["1612"],"next_hw":"גפף","prev_hw":"גפן","all_cited":true,"quotes":[],"GK":["1728"],"TWOT":["372a"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}