{"headword":"יָגוֹן","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>n.</strong>[<strong>m.</strong>] <strong>grief, sorrow</strong>;—abs. <span dir=\"rtl\">יָגוֹן</span> <a data-ref=\"Genesis 42:38\" href=\"/Genesis.42.38\">Gn 42:38</a> + 12 times; sf. <span dir=\"rtl\">(מִ)יגוֹנָם</span> <a data-ref=\"Jeremiah 31:13\" href=\"/Jeremiah.31.13\">Je 31:13</a>;—<em>sorrow</em>, <a data-ref=\"Genesis 42:38\" href=\"/Genesis.42.38\">Gn 42:38</a>; <a data-ref=\"Genesis 44:31\" href=\"/Genesis.44.31\">44:31</a> (J), <a data-ref=\"Psalms 13:3\" href=\"/Psalms.13.3\">ψ 13:3</a> <a data-ref=\"Jeremiah 8:18\" href=\"/Jeremiah.8.18\">Je 8:18</a>; ‖ <span dir=\"rtl\">אֲנָחָה</span> <a data-ref=\"Psalms 31:11\" href=\"/Psalms.31.11\">ψ 31:11</a> <a data-ref=\"Isaiah 35:10\" href=\"/Isaiah.35.10\">Is 35:10</a>; <a data-ref=\"Isaiah 51:11\" href=\"/Isaiah.51.11\">51:11</a>; cf. <a data-ref=\"Psalms 107:39\" href=\"/Psalms.107.39\">ψ 107:39</a> (‖ <span dir=\"rtl\">עֹצֶר</span>, <span dir=\"rtl\">רָעָה</span>), <a data-ref=\"Psalms 116:3\" href=\"/Psalms.116.3\">116:3</a> (‖ <span dir=\"rtl\">צָרָה</span>), <a data-ref=\"Jeremiah 20:18\" href=\"/Jeremiah.20.18\">Je 20:18</a> (‖ <span dir=\"rtl\">עָמָל</span>), <a data-ref=\"Jeremiah 31:13\" href=\"/Jeremiah.31.13\">31:13</a> (‖ <span dir=\"rtl\">אֵבֶל</span>, opp. <span dir=\"rtl\">שִׂמַּחְתִּים</span>), <a data-ref=\"Jeremiah 45:3\" href=\"/Jeremiah.45.3\">45:3</a> (‖ <span dir=\"rtl\">מַכְאֹבִי</span>), <a data-ref=\"Ezekiel 23:33\" href=\"/Ezekiel.23.33\">Ez 23:33</a> (‖ <span dir=\"rtl\">שִׁכָּרוֹן</span>, but Co.; <span dir=\"rtl\">שׁברון</span> with Codd.; cf. <a data-ref=\"Ezekiel 21:11\" href=\"/Ezekiel.21.11\">21:11</a>); <a data-ref=\"Esther 9:22\" href=\"/Esther.9.22\">Est 9:22</a> (opp. <span dir=\"rtl\">שִׂמְחָה</span>)."}]},"rid":"BDB03793","strong_numbers":["3015"],"next_hw":"תּוּגָה","prev_hw":"יָגָה","all_cited":true,"quotes":[],"GK":["3326"],"TWOT":["839a"],"parent_lexicon_details":{"n