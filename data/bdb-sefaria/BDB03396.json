{"headword":"חֶצְרוֹן","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>n.pr.loc.</strong> et <strong>pers. (</strong>cf. Sab. <span dir=\"rtl\">חצֿרן</span> n.pr.loc. vel. trib. Hal<sup>No. 651</sup> DHM<sup>ZMG 1883, 15</sup><strong>)</strong>—"},{"senses":[{"definition":"<strong> n.pr.loc.</strong> 𝔊 Ασωρων, Ασερων, Εσρωμ:"},{"senses":[{"definition":"<span dir=\"rtl\">חֶצְרוֹן</span> <a data-ref=\"Joshua 15:3\" href=\"/Joshua.15.3\">Jos 15:3</a> place in extreme south of Judah, + <span dir=\"rtl\">אַדָּ֫רָה</span> = <span dir=\"rtl\">חֲצַר־אַדָּר</span> (q.v.) <a data-ref=\"Numbers 34:4\" href=\"/Numbers.34.4\">Nu 34:4</a>."}],"num":"a."},{"senses":[{"definition":"<span dir=\"rtl\">קְרִיּוֹת חֶצְרוֹן הִיא חָצוֹר</span> <a data-ref=\"Joshua 15:25\" href=\"/Joshua.15.25\">Jos 15:25</a> another town of Judah in south."}],"num":"b."}],"num":"1."},{"senses":[{"definition":"<strong> n.pr.m.</strong> 𝔊 Ασρωμ(ν), Εσρων, etc.:"},{"senses":[{"definition":"<span dir=\"rtl\">חֶצְרֹן</span> son of Reuben <a data-ref=\"Genesis 46:9\" href=\"/Genesis.46.9\">Gn 46:9</a>; <a data-ref=\"Exodus 6:14\" href=\"/Exodus.6.14\">Ex 6:14</a>; <a data-ref=\"Numbers 26:6\" href=\"/Numbers.26.6\">Nu 26:6</a> = <span dir=\"rtl\">חֶצְרוֹן</span> <a data-ref=\"I Chronicles 5:3\" href=\"/I_Chronicles.5.3\">1 Ch 5:3</a>."}],"num":"a."},{"senses":[{"definition":"son of Pereṣ and grandson of Judah <a data-ref=\"Genesis 46:12\" href=\"/Genesis.46.12\">Gn 46:12</a>; <a data-ref=\"Numbers 26:21\" href=\"/Numbers.26.21\">Nu 26:21</a> = <span dir=\"rtl\">חֶצְרוֹן</span> <a data-ref=\"Ruth 4:18\" href=\"/Ruth.4.18\">Ru 4:18</a>, <a data-ref=\"Ruth 4:19\" href=\"/Ruth.4.19\">19</a>; <a data-ref=\"I Chronicles 2:5\" href=\"/I_Chronicles.2.5\">1 Ch 2:5</a>, <a data-ref=\"I Chronicles 2:9\" href=\"/I_Chronicles.2.9\">9</a>, <a data-ref=\"I Chronicles 2:18\" href=\"/I_Chronicles.2.18\">18</a>, <a data-ref=\"I Chronicles 2:21\" href=\"/I_Chronicles.2.21\">21</a>, <a data-ref=\"I Chronicles 2:24\" href=\"/I_Chronicles.2.24\">24</a><sup>(×2)</sup>, <a data-ref=\"I Chronicles 2:25\" href=\"/I_Chronicles.2.25\">25</a>; <a data-ref=\"I Chronicles 4:1\" href=\"/I_Chronicles.4.1\">4:1</a>."}],"num":"b."}],"num":"2."}]},"rid":"BDB03396","strong_numbers":["2696"],"next_hw":"חֶצְרוֹנִי","prev_hw":"חֶצְרוֹ","all_cited":true,"alt_headwords":[{"word":"חֶצְרֹן"}],"quotes":[],"GK":["2969","2970"],"TWOT":[],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}