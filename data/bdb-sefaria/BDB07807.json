{"headword":"פּוּחַ","parent_lexicon":"BDB Dictionary","content":{"senses":[{"definition":"<strong>vb. breathe, blow (</strong>NH <span dir=\"rtl\">פּוּחַ</span> <em>blow out;</em> Arabic <span dir=\"rtl\">(فوخ)</span>, <span dir=\"rtl\">فَاخَ</span> = Heb., so Aramaic <span dir=\"rtl\">פּוּחַ</span>, <span dir=\"rtl\">ܦܳܚ</span> <strong>)</strong>;—"},{"senses":[{"definition":"Impf. 3 ms. <span dir=\"rtl\">יָפוּחַ הַיּוֹם</span> <a data-ref=\"Song of Songs 2:17\" href=\"/Song_of_Songs.2.17\">Ct 2:17</a>; <a data-ref=\"Song of Songs 4:6\" href=\"/Song_of_Songs.4.6\">4:6</a> until <em>the day breathes</em>, i.e. grows cool."}],"form":"Qal"},{"senses":[{"definition":"Impf. 3 ms. <span dir=\"rtl\">יָפִיחַ</span> <a data-ref=\"Psalms 10:5\" href=\"/Psalms.10.5\">ψ 10:5</a> +; <span dir=\"rtl\">יָפִחַ</span> <a data-ref=\"Proverbs 14:25\" href=\"/Proverbs.14.25\">Pr 14:25</a>; <span dir=\"rtl\">וְיָפֵחַ</span> <a data-ref=\"Habakkuk 2:3\" href=\"/Habakkuk.2.3\">Hb 2:3</a>, etc.; Imv. fs. <span dir=\"rtl\">הָפִיחִי</span> <a data-ref=\"Song of Songs 4:16\" href=\"/Song_of_Songs.4.16\">Ct 4:16</a>;—"},{"senses":[{"definition":"<em>cause</em> garden (acc.) <em>to exhale</em> (sc. odours) <a data-ref=\"Song of Songs 4:16\" href=\"/Song_of_Songs.4.16\">Ct 4:16</a>."}],"num":"1."},{"senses":[{"senses":[{"definition":"<em>puff, snort</em>, against, ב pers., <a data-ref=\"Psalms 10:5\" href=\"/Psalms.10.5\">ψ 10:5</a>."}],"num":"a."},{"senses":[{"definition":"<span dir=\"rtl\">עַל</span> pers., <a data-ref=\"Ezekiel 21:36\" href=\"/Ezekiel.21.36\">Ez 21:36</a> with the fire of my wrath <em>will I blow against thee</em>."}],"num":"b."},{"senses":[{"definition":"<em>excite, inflame</em> city <a data-ref=\"Proverbs 29:8\" href=\"/Proverbs.29.8\">Pr 29:8</a>."}],"num":"c."},{"senses":[{"definition":"c. <span dir=\"rtl\">לוֹ</span> <a data-ref=\"Psalms 12:6\" href=\"/Psalms.12.6\">ψ 12:6</a> <em>puff</em>, = <em>pant for it</em> (so most; Thes Hi al. <em>against whom men puff;</em> Bae <span dir=\"rtl\">אֹפִיעַ לוֹ</span> <em>I will shine forth to him</em>); <span dir=\"rtl\">לַקֵּץ</span> <a data-ref=\"Habakkuk 2:3\" href=\"/Habakkuk.2.3\">Hb 2:3</a> the vision <em>panteth</em> (hasteth) <em>towards the end</em> (so most)."}],"num":"d."}],"num":"2."},{"senses":[{"definition":"<em>breathe out, utter</em>, <span dir=\"rtl\">כְּזָבִים</span> <a data-ref=\"Proverbs 6:19\" href=\"/Proverbs.6.19\">Pr 6:19</a>; <a data-ref=\"Proverbs 14:5\" href=\"/Proverbs.14.5\">14:5</a>, <a data-ref=\"Proverbs 14:25\" href=\"/Proverbs.14.25\">25</a>; <a data-ref=\"Proverbs 19:5\" href=\"/Proverbs.19.5\">19:5</a>, <a data-ref=\"Proverbs 19:9\" href=\"/Proverbs.19.9\">9</a>, <span dir=\"rtl\">אֱמוּנָה</span> <a data-ref=\"Proverbs 12:17\" href=\"/Proverbs.12.17\">12:17</a>."}],"num":"3."}],"form":"Hiph."}]},"rid":"BDB07807","strong_numbers":["6315"],"next_hw":"פִּיחַ","prev_hw":"הֲפוּגָה","all_cited":true,"brackets":"first_word","root":true,"quotes":[],"GK":["7031","7032"],"TWOT":["1741"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}