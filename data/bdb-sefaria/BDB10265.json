ms 65:2\" href=\"/Psalms.65.2\">ψ 65:2</a>."}],"num":"1."},{"senses":[{"definition":"<em>be repaid, requited</em>, <a data-ref=\"Jeremiah 18:20\" href=\"/Jeremiah.18.20\">Je 18:20</a>; <a data-ref=\"Proverbs 11:31\" href=\"/Proverbs.11.31\">Pr 11:31</a>; <a data-ref=\"Proverbs 13:13\" href=\"/Proverbs.13.13\">13:13</a>."}],"num":"2."}],"form":"Pu."},{"senses":[{"senses":[{"definition":"<em>complete, perform:</em> Impf. 3 ms. <span dir=\"rtl\">יַשְׁלִים</span> <a data-ref=\"Job 23:14\" href=\"/Job.23.14\">Jb 23:14</a>; <a data-ref=\"Isaiah 44:26\" href=\"/Isaiah.44.26\">Is 44:26</a>, <span dir=\"rtl\">יַשְׁלִם</span> v <a data-ref=\"Isaiah 44:28\" href=\"/Isaiah.44.28\">28</a>."}],"num":"1."},{"senses":[{"definition":"<em>make an end of</em>, 2 ms. sf. <span dir=\"rtl\">תַּשְׁלִימֵנִי</span> <a data-ref=\"Isaiah 38:12\" href=\"/Isaiah.38.12\">Is 38:12</a>, <a data-ref=\"Isaiah 38:13\" href=\"/Isaiah.38.13\">13</a> (𝔊 Du Marti <em>deliver up</em> to pains, as in Aramaic)."}],"num":"2."}],"form":"Hiph."}]},"rid":"BDB10265","strong_numbers":["7999","8003","8004"],"next_hw":"שָׁלוֹם","prev_hw":"שָׁלָל","brackets":"first_word","root":true,"occurrences":"103","quotes":[],"GK":["8966","8969","8970","8971"],"TWOT":["2401","2401c","2401d"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}