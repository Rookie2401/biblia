data-ref=\"Nehemiah 1:4\" href=\"/Nehemiah.1.4\">Ne 1:4</a> <a data-ref=\"Ezekiel 7:12\" href=\"/Ezekiel.7.12\">Ez 7:12</a> cf. <a data-ref=\"Daniel 10:2\" href=\"/Daniel.10.2\">Dn 10:2</a>."}],"form":"Hithp."},{"senses":[{"definition":"Pf. <span dir=\"rtl\">הֶאֱבַלְתִּי</span> <a data-ref=\"Ezekiel 31:15\" href=\"/Ezekiel.31.15\">Ez 31:15</a>; Impf. <span dir=\"rtl\">וַיַּאֲבֶל־</span> <a data-ref=\"Lamentations 2:8\" href=\"/Lamentations.2.8\">La 2:8</a>;—<em>cause to mourn;</em> <a data-ref=\"Ezekiel 31:15\" href=\"/Ezekiel.31.15\">Ez 31:15</a> abs. MT, but A B Co obj. <span dir=\"rtl\">תהום</span> sq. <span dir=\"rtl\">על</span>, <em>caused the deep to mourn over;</em> <a data-ref=\"Lamentations 2:8\" href=\"/Lamentations.2.8\">La 2:8</a> obj. wall etc.; (both these fig.; cf. Qal)."}],"form":"Hiph."}]},"rid":"BDB00061","strong_numbers":["56"],"next_hw":"אֵ֫בֶל","prev_hw":"אָבַךְ","all_cited":true,"ordinal":"I.","root":true,"occurrences":"39","quotes":[],"GK":["61","62"],"TWOT":["6"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}