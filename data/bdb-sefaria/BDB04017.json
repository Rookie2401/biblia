 <span dir=\"rtl\">נוֹסָפוֹת</span> <a data-ref=\"Isaiah 15:9\" href=\"/Isaiah.15.9\">Is 15:9</a>;—"},{"senses":[{"definition":"<em>join</em> (intr.), <em>join oneself to</em> <span dir=\"rtl\">(עַל)</span> <a data-ref=\"Exodus 1:10\" href=\"/Exodus.1.10\">Ex 1:10</a>."}],"num":"1."},{"senses":[{"definition":"<em>be joined, added to</em> <span dir=\"rtl\">(עַל)</span> <a data-ref=\"Numbers 36:3\" href=\"/Numbers.36.3\">Nu 36:3</a>, <a data-ref=\"Numbers 36:4\" href=\"/Numbers.36.4\">4</a> <a data-ref=\"Jeremiah 36:32\" href=\"/Jeremiah.36.32\">Je 36:32</a>; pt. abs. <em>is increased</em> <a data-ref=\"Proverbs 11:24\" href=\"/Proverbs.11.24\">Pr 11:24</a>; pt. fem. pl. = <em>things added, additions</em> (i.e additional calamities) <a data-ref=\"Isaiah 15:9\" href=\"/Isaiah.15.9\">Is 15:9</a>."}],"num":"2."}],"all_cited":true,"form":"Niph."},{"senses":[{"definition":"Pf. <span dir=\"rtl\">הֹסִיף</span> <a data-ref=\"II Kings 24:7\" href=\"/II_Kings.24.7\">2 K 24:7</a>; <span dir=\"rtl\">הוֹסַ֫פְתָּ</span> <a data-ref=\"I Kings 10:7\" href=\"/I_Kings.10.7\">1 K 10:7</a> etc.; Impf.<sub>164</sub> <span dir=\"rtl\">יוֹסִיף</span> <a data-ref=\"Joshua 23:13\" href=\"/Joshua.23.13\">Jos 23:13</a> +; juss. <span dir=\"rtl\">יוֹסֵף</span> <a data-ref=\"Genesis 30:24\" href=\"/Genesis.30.24\">Gn 30:24</a> +; <span dir=\"rtl\">י֫וֹסֶף</span> (bef. tone) <a data-ref=\"Proverbs 1:5\" href=\"/Proverbs.1.5\">Pr 1:5</a>; <a data-ref=\"Proverbs 9:9\" href=\"/Proverbs.9.9\">9:9</a>; <span dir=\"rtl\">וַיּ֫וֹסֶף</span> <a data-ref=\"Isaiah 7:10\" href=\"/Isaiah.7.10\">Is 7:10</a> +; <span dir=\"rtl\">וַיֹּ֫אסֶף</span> <a data-ref=\"I Samuel 18:29\" href=\"/I_Samuel.18.29\">1 S 18:29</a>; 2 ms. <span dir=\"rtl\">תּוֹסִיף</span> <a data-ref=\"Amos 7:13\" href=\"/Amos.7.13\">Am 7:13</a> +; juss. <span dir=\"rtl\">תֹּסֵף</span> <a data-ref=\"Deuteronomy 13:1\" href=\"/Deuteronomy.13.1\">Dt 13:1</a>; <span dir=\"rtl\">תּוֹסַ֑ף</span> <a data-ref=\"Job 40:32\" href=\"/Job.40.32\">Jb 40:32<