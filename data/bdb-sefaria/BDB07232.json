</sup>).—On <span dir=\"rtl\">שַׁעַר הָעַיִן</span> <a data-ref=\"Nehemiah 2:14\" href=\"/Nehemiah.2.14\">Ne 2:14</a>; <a data-ref=\"Nehemiah 3:15\" href=\"/Nehemiah.3.15\">3:15</a>; <a data-ref=\"Nehemiah 12:37\" href=\"/Nehemiah.12.37\">12:37</a> v. <a ,=\"\" data-ref=\"BDB, שַׁ֫עַר²\" dir=\"rtl\" href=\"/BDB,_שַׁ֫עַר²\">שַׁעַר</a>."}],"num":"d."}]},"rid":"BDB07232","strong_numbers":["5869","5870","5871","5872","5873","5874","5875","5876","5877","5878","5879","5880","5881","5882","5883","5884","5885","5886","5887"],"next_hw":"עַ֫יִן³","prev_hw":"עִין","all_cited":true,"ordinal":"II.","quotes":[],"GK":["6412","6524","6525","6526"],"TWOT":["1612a","1613","2906"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}