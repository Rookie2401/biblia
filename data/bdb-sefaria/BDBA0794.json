{"headword":"שַׁלִּיט","parent_lexicon":"BDB Aramaic Dictionary","content":{"senses":[{"definition":"<strong>adj. having mastery, ruling</strong>;—abs. <span dir=\"rtl\">שׁ׳</span> <a data-ref=\"Ezra 7:24\" href=\"/Ezra.7.24\">Ezr 7:24</a> +, emph. <span dir=\"rtl\">א—ָ</span> <a data-ref=\"Daniel 2:15\" href=\"/Daniel.2.15\">Dn 2:15</a>; mpl. <span dir=\"rtl\">שְׁלִיטִין</span> <a data-ref=\"Ezra 4:20\" href=\"/Ezra.4.20\">Ezr 4:20</a>, -<span dir=\"rtl\">טִן</span> <a data-ref=\"Daniel 4:23\" href=\"/Daniel.4.23\">Dn 4:23</a>;—"},{"senses":[{"definition":"<em>having, exercising, mastery:</em>"},{"senses":[{"definition":"of God, sq. ב, <a data-ref=\"Daniel 4:14\" href=\"/Daniel.4.14\">Dn 4:14</a>, <a data-ref=\"Daniel 4:22\" href=\"/Daniel.4.22\">22</a>, <a data-ref=\"Daniel 4:29\" href=\"/Daniel.4.29\">29</a>; <a data-ref=\"Daniel 5:21\" href=\"/Daniel.5.21\">5:21</a>; abs., of heavens <a data-ref=\"Daniel 4:23\" href=\"/Daniel.4.23\">4:23</a>."}],"num":"a."},{"senses":[{"definition":"of kings <a data-ref=\"Ezra 4:20\" href=\"/Ezra.4.20\">Ezr 4:20</a> <span dir=\"rtl\">(ב)</span>."}],"num":"b."}],"num":"1."},{"senses":[{"definition":"as n. = <em>ruler</em> <a data-ref=\"Daniel 2:10\" href=\"/Daniel.2.10\">Dn 2:10</a>; <a data-ref=\"Daniel 5:29\" href=\"/Daniel.5.29\">5:29</a>, <em>captain</em> <a data-ref=\"Daniel 2:15\" href=\"/Daniel.2.15\">Dn 2:15</a>."}],"num":"2."},{"senses":[{"definition":"<em>having authority</em> to do a thing (Inf.), hence impers. = <em>it is authorized</em>, <a data-ref=\"Ezra 7:24\" href=\"/Ezra.7.24\">Ezr 7:24</a> (so often in Syriac; cf. S-C<sup>A 11 +</sup> <span dir=\"rtl\">אנת שליט למבנה</span>)."}],"num":"3."}]},"rid":"BDBA0794","strong_numbers":["7989","7990"],"next_hw":"שְׁלֵם","prev_hw":"שָׁלְטָן","all_cited":true,"quotes":[],"GK":["8954"],"TWOT":["2396a","3034b"],"parent_lexicon_details":{"name":"BDB Aramaic Dictionary","language":"ara.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"