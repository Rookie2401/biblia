:"Pt. <span dir=\"rtl\">מְאַחֵז</span> <a data-ref=\"Job 26:9\" href=\"/Job.26.9\">Jb 26:9</a> c. acc. <em>enclose, overlay</em> (so Assyrian Dl<sup>W, p. 294</sup>, cf. Aramaic <span dir=\"rtl\">ܐܚܕ</span>, <em>shut</em>)."}],"form":"Pi."},{"senses":[{"definition":"Pt. pl. <span dir=\"rtl\">מָאֳחָזִים</span> <a data-ref=\"II Chronicles 9:18\" href=\"/II_Chronicles.9.18\">2 Ch 9:18</a> <em>fastened to</em> sq. <span dir=\"rtl\">לְ</span>."}],"form":"Hoph."}]},"rid":"BDB00352","strong_numbers":["270"],"next_hw":"אָחָז","prev_hw":"אַחְוָה","all_cited":true,"root":true,"occurrences":"68","quotes":[],"GK":["290","296","297"],"TWOT":["64"],"parent_lexicon_details":{"name":"BDB Dictionary","language":"heb.biblical","to_language":"eng","text_categories":[],"source":"BDB Dictionary","attribution":"F. Brown, S. Driver & C. Briggs","index_title":"BDB","version_title":"A Hebrew and English lexicon of the Old Testament, by Francis Brown. With the co-operation of S. R. Driver and Charles A. Briggs. Oxford, 1906","version_lang":"en","should_autocomplete":true}}